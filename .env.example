# ============================================
# MAF RUNNING COACH - ENVIRONMENT VARIABLES
# ============================================
# Production Environment Configuration
# Server: Ubuntu 24.04 LTS, 16GB RAM
# Domain: maf.run
# ============================================

# --------------------------------------------
# DOMAIN CONFIGURATION
# --------------------------------------------
APP_DOMAIN=app.maf.run
API_DOMAIN=api.maf.run
BASE_DOMAIN=maf.run

# --------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# --------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# SECURITY: Generate strong password (min 16 characters)
# Example: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_postgres_password_here_min_16_chars

# --------------------------------------------
# N8N CONFIGURATION
# --------------------------------------------
N8N_HOST=api.maf.run
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://api.maf.run/

# SECURITY: Generate encryption key (32 characters)
# Example: openssl rand -hex 16
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here

# N8N Editor Base URL
N8N_EDITOR_BASE_URL=https://api.maf.run

# --------------------------------------------
# CLOUDFLARE TUNNEL
# --------------------------------------------
# Tunnel ID: e20b0b88-6187-4869-9063-eba523eaea2b
# Get token from: https://one.dash.cloudflare.com/
TUNNEL_TOKEN=eyJhIjoiOTRkNzcyNjgxNzhlOGVjYWRjMDgzYWVjYzA4YmU3NWEiLCJ0IjoiZTIwYjBiODgtNjE4Ny00ODY5LTkwNjMtZWJhNTIzZWFlYTJiIiwicyI6Ik5HUmpNVGRrTmpZdFlqY3dZeTAwWldKaUxXRTRaVE10TXprellUUTRZMk14T1RVMyJ9
TUNNEL_ID=e20b0b88-6187-4869-9063-eba523eaea2b

# --------------------------------------------
# SYSTEM CONFIGURATION
# --------------------------------------------
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh

# --------------------------------------------
# OPTIONAL: PERFORMANCE TUNING
# --------------------------------------------
# Uncomment and adjust if needed

# PostgreSQL Performance
# POSTGRES_MAX_CONNECTIONS=100
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# N8N Performance
# N8N_PAYLOAD_SIZE_MAX=16
# N8N_MAX_EXECUTION_TIMEOUT=3600

# --------------------------------------------
# HƯỚNG DẪN SỬ DỤNG
# --------------------------------------------
# 
# 1. Copy file này thành .env:
#    cp .env.example .env
#
# 2. Generate secure passwords và keys:
#    # PostgreSQL Password (32 chars)
#    openssl rand -base64 32
#    
#    # N8N Encryption Key (32 chars hex)
#    openssl rand -hex 16
#
# 3. Chỉnh sửa các giá trị trong .env:
#    - POSTGRES_PASSWORD: Password mạnh cho database
#    - N8N_ENCRYPTION_KEY: Key để encrypt credentials
#    - TUNNEL_TOKEN: Token từ Cloudflare (đã có)
#
# 4. Verify configuration:
#    docker-compose config
#
# 5. Khởi động services:
#    docker-compose up -d
#
# 6. Kiểm tra status:
#    docker-compose ps
#    docker-compose logs -f
#
# 7. Access applications:
#    Frontend: https://app.maf.run
#    N8N:      https://api.maf.run
#
# --------------------------------------------
# SECURITY NOTES
# --------------------------------------------
#
# ⚠️  IMPORTANT SECURITY REQUIREMENTS:
#
# 1. NEVER commit .env file to git
# 2. Use strong passwords (min 16 chars, mixed case, numbers, symbols)
# 3. Rotate encryption keys periodically
# 4. Keep Cloudflare tunnel token secure
# 5. Backup .env file securely
# 6. Use different passwords for dev/staging/production
# 7. Enable Cloudflare Access for additional security
#
# --------------------------------------------
# CLOUDFLARE DNS SETUP
# --------------------------------------------
#
# Tunnel will automatically create these DNS records:
# - app.maf.run → CNAME to <tunnel-id>.cfargotunnel.com
# - api.maf.run → CNAME to <tunnel-id>.cfargotunnel.com
#
# You can verify in Cloudflare Dashboard:
# DNS > Records
#
# --------------------------------------------
# TROUBLESHOOTING
# --------------------------------------------
#
# If services fail to start:
#
# 1. Check environment variables:
#    docker-compose config
#
# 2. Check logs:
#    docker-compose logs maf-app
#    docker-compose logs postgres
#    docker-compose logs n8n
#    docker-compose logs cloudflared
#
# 3. Verify database connection:
#    docker exec -it maf-postgres psql -U n8n -d n8n
#
# 4. Test tunnel connectivity:
#    docker exec -it maf-cloudflare-tunnel cloudflared tunnel info
#
# 5. Check network:
#    docker network inspect maf_network
#
# 6. Verify volumes:
#    docker volume ls | grep maf
#
# --------------------------------------------
