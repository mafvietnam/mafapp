# ============================================
# DOCKERIGNORE - MAF RUNNING COACH
# ============================================

# Node modules (sẽ được cài lại trong container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build directories
dist/
build/
.vite/
coverage/

# Development files
*.log
*.pid
*.seed
*.pid.lock

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes
.github/

# Documentation & Config (không cần trong container)
CHANGELOG.md
LICENSE
# Keep README.md, DEPLOYMENT.md, DOCKER_REVIEW.md for reference

# Test files
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.test.js
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js
jest.config.js
.nyc_output/
coverage/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env*.local

# Docker files (không cần copy vào chính nó)
Dockerfile*
docker-compose*.yml
.docker/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml
Jenkinsfile

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Backup files
*.bak
*.backup
*.old
*~

# Source map files (optional, uncomment nếu không muốn deploy source maps)
# *.map

# TypeScript cache
*.tsbuildinfo

# Optional: Các file txt cũ (nếu không cần)
*.txt
!package*.json
