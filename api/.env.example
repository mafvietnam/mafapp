# Database
DATABASE_URL=postgresql://maf_user:changeme@postgres:5432/maf

# Redis
REDIS_URL=redis://redis:6379

# JWT (base64-encoded RSA keys)
JWT_PRIVATE_KEY=base64-encoded-private-key
JWT_PUBLIC_KEY=base64-encoded-public-key

# WordPress OAuth
WP_OAUTH_CLIENT_ID=your-wp-oauth-client-id
WP_OAUTH_REDIRECT_URI=https://api.maf.run/auth/callback
WP_OAUTH_URL=https://maf.run

# CORS
CORS_ORIGIN=https://app.maf.run

# Server
PORT=3001
