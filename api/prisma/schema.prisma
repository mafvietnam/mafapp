generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COACH
  ADMIN
}

enum StravaConnectionStatus {
  CONNECTED
  DISCONNECTED
  TOKEN_EXPIRED
  ERROR
}

enum GarminConnectionStatus {
  CONNECTED
  DISCONNECTED
  TOKEN_EXPIRED
  ERROR
}

/// Origin of a StravaActivity row. STRAVA = pulled via OAuth sync/webhook.
/// UPLOAD = parsed from a user-uploaded GPX/TCX tracklog (no OAuth — bypasses the 10-athlete slot cap).
enum ActivitySource {
  STRAVA
  UPLOAD
}

model User {
  id        String       @id @default(uuid())
  wpUserId  Int?         @unique
  googleId  String?      @unique
  email     String       @unique
  name      String
  avatar    String?
  role      Role         @default(USER)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile              UserProfile?
  garminConnection     GarminConnection?
  garminActivities     GarminActivity[]
  garminDailySummaries GarminDailySummary[]
  stravaConnection     StravaConnection?
  stravaActivities     StravaActivity[]
  stravaActivityDetails StravaActivityDetail[]
  dailyCheckins        DailyCheckin[]
}

model GarminConnection {
  id              String                 @id @default(uuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garminUserId    String?
  accessToken     String                 // AES-256-GCM encrypted email
  refreshToken    String                 // AES-256-GCM encrypted password
  tokenExpiry     DateTime?
  status          GarminConnectionStatus @default(CONNECTED)
  backfillStatus  String                 @default("NONE")
  lastSyncAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model GarminActivity {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  garminActivityId String   @unique
  activityType     String
  startTime        DateTime
  duration         Int      // seconds
  distance         Float?   // meters
  avgHeartRate     Int?
  maxHeartRate     Int?
  minHeartRate     Int?
  avgPace          Float?   // min/km
  calories         Int?
  vo2Max           Float?
  trainingEffect   Float?
  isDuplicate      Boolean  @default(false)         // true when Strava has same run
  createdAt        DateTime @default(now())

  @@index([userId, startTime])
}

model GarminDailySummary {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  steps            Int?
  restingHeartRate Int?
  avgHeartRate     Int?
  maxHeartRate     Int?
  minHeartRate     Int?
  sleepDuration    Int?     // minutes
  sleepScore       Float?
  stressAvg        Int?
  calories         Int?
  activeMinutes    Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Key-value store for app-wide settings (e.g. Garmin OAuth credentials)
model AppSetting {
  key       String   @id
  value     String   // encrypted for secrets, plain for flags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StravaConnection {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  stravaAthleteId       String?                // Strava numeric athlete ID
  accessToken           String                 // AES-256-GCM encrypted
  refreshToken          String                 // AES-256-GCM encrypted
  tokenExpiresAt        DateTime               // Strava tokens expire every ~6h
  webhookSubscriptionId Int?                   // Strava webhook subscription ID
  status                StravaConnectionStatus @default(CONNECTED)
  lastSyncAt            DateTime?
  lastSyncStartedAt     DateTime?              // Set when admin-triggered sync begins
  lastSyncFinishedAt    DateTime?              // Set when sync completes (success or error)
  lastSyncError         String?                // Last sync error message (max 500 chars)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StravaActivity {
  id               String   @id @default(cuid())
  userId           String
  // Global-unique. For STRAVA rows = Strava numeric activity ID (as string).
  // For UPLOAD rows = "upload_" + content hash. Reads/writes MUST be userId-scoped
  // (this is not a tenant boundary) — see strava-upload.service.ts.
  stravaActivityId String   @unique
  source           ActivitySource @default(STRAVA)  // STRAVA (OAuth sync) | UPLOAD (GPX/TCX file)
  name             String
  type             String                           // Run | TrailRun | VirtualRun
  startDate        DateTime
  distance         Float                            // meters
  movingTime       Int                              // seconds
  elapsedTime      Int                              // seconds
  avgHeartRate     Int?
  maxHeartRate     Int?
  avgSpeed         Float?                           // m/s
  maxSpeed         Float?                           // m/s
  totalElevationGain Float?                         // meters
  calories         Float?
  avgPace          Float?                           // min/km (computed on insert)
  isDuplicate      Boolean  @default(false)         // true when Garmin has same run
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([userId, stravaActivityId])
  @@index([userId, source])
}

/// Lazily-hydrated detail + streams cache for a single StravaActivity (1-1 via stravaActivityId).
/// userId is duplicated here (not derived via the StravaActivity relation) so cache reads stay
/// userId-scoped even if the activity is later reassigned/deleted — see disconnect() purge.
model StravaActivityDetail {
  id               String   @id @default(cuid())
  stravaActivityId String   @unique                // 1-1 with StravaActivity.stravaActivityId
  userId           String
  detailJson       Json                             // { description, deviceName, gearName, calories, splitsMetric[] }
  streamsJson      Json?                            // { time[], heartrate[], velocitySmooth[], altitude[], distance[] } | null
  fetchedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Optional daily morning check-in feeding the "Today" readiness engine (phase-01).
/// `date` is the SERVER-derived Asia/Ho_Chi_Minh calendar date (RED TEAM FIX #7) —
/// the client never sends the authoritative date for the unique key.
/// `onDelete: Cascade` satisfies the PII-erasure requirement (RED TEAM FIX #11):
/// deleting a User purges their check-in vitals (restingHr, fatigue, sleep, soreness).
model DailyCheckin {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  sleepQuality Int // 1-5
  fatigue      Int // 1-5
  soreness     String? // optional short tag e.g. "calf", "knee", "none"
  note         String? // optional free note
  restingHr    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model UserProfile {
  id                         String    @id @default(uuid())
  userId                     String    @unique
  age                        Int
  height                     Float
  weight                     Float
  experience                 String
  commitment                 String
  isRecovering               Boolean   @default(false)
  isMedicatedOrInjured       Boolean   @default(false)
  isMedicalClearanceConfirmed Boolean  @default(false)
  previousMonthPace          String?
  isProbation                Boolean   @default(false)
  probationStartDate         DateTime?
  lastLongRunDuration        Int?
  lastLongRunHeartRate       Int?
  lastLongRunFeeling         String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
