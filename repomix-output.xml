      expect(result[0].duration).toBe(90); // Senior rule applied at age 60
    });

    it('should preserve non-RUN/LONG_RUN types (RECOVERY, CROSS_TRAIN)', () => {
      const profile: UserProfile = {
        age: '50',
        height: '170',
        weight: '100',
