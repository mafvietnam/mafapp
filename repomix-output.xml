<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAF Run - Pro Desktop Web</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.2); border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }

        .glass-nav {
            background: rgba(11, 17, 33, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .desktop-card {
            background: #111827; /* Tailwind gray-900 - Nền đặc, chuyên nghiệp cho Desktop */
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .gradient-text {
            background: linear-gradient(to right, #F42A68, #9130F8);
            -webkit-background-clip: text;
            color: transparent;
        }
    </style>
</head>
<body class="bg-[#0B1121] min-h-screen antialiased text-white font-sans relative">

    <!-- Background Image Banner (Chỉ lấy ở nửa trên để làm Header Banner) -->
    <div class="absolute top-0 left-0 w-full h-[400px] bg-[url('https://maf.run/wp-content/uploads/2026/03/banner.webp')] bg-cover bg-center z-0 opacity-30 mask-image: linear-gradient(to bottom, black, transparent)"></div>
    <div class="absolute top-0 left-0 w-full h-[400px] bg-gradient-to-b from-[#0B1121]/50 to-[#0B1121] z-0"></div>

    <!-- 1. TOP NAVIGATION (Chuẩn Web Desktop) -->
    <nav class="glass-nav sticky top-0 z-50 w-full h-[72px]">
