        { day: 'Thứ 7', activity: 'Endurance Long Run', duration: 120, type: 'LONG_RUN' },
        { day: 'Chủ Nhật', activity: 'Nghỉ hoàn toàn', duration: 0, type: 'REST' },
      ];

    default:
      return [];
  }
};
