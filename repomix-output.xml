    it('should convert LONG_RUN to WALK when recovering', () => {
      const profile: UserProfile = {
        age: '50',
        height: '172',
        weight: '78',
        experience: ExperienceLevel.ADVANCED,
        isRecovering: true,
        isMedicatedOrInjured: false,
