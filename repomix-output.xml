        50, 158, mafHr, CommitmentLevel.BASE, 40, ExperienceLevel.ADVANCED, 'VERY_TIRED'
      );
      expect(result.adjustmentType).toBe('DECREASE');
      expect(result.duration).toBeLessThan(50);
    });
  });
